# ==============================================================================
# InterDash - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it contains secrets.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------

# Node environment (development | production)
NODE_ENV=development

# Port the Express server listens on
PORT=5173

# Public URL of the application
# Development: http://localhost:5173
# Production:  https://vps.kinetichost.pro
APP_URL=http://localhost:5173

# Session secret — MUST be a random 64-char hex string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite database file path (relative to vite-version/)
DATABASE_PATH=./data/interdash.db

# ------------------------------------------------------------------------------
# 2. Discord OAuth2 Configuration (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Create an application at: https://discord.com/developers/applications
#
# Add redirect URL in Discord Developer Portal > OAuth2 > Redirects:
#   Development: http://localhost:5173/api/auth/discord/callback
#   Production:  https://your-domain.com/api/auth/discord/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
DISCORD_SCOPES=identify email

# ------------------------------------------------------------------------------
# 3. Administrator Configuration (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Discord User ID of the platform owner. Gets 'owner' role on first login.
# Get your ID: Discord Settings > Advanced > Developer Mode > Right-click > Copy User ID
DISCORD_ADMIN_USER_ID=

# ------------------------------------------------------------------------------
# 4. Client-Side (VITE_*) — bundled into JS, NO secrets here
# ------------------------------------------------------------------------------

# Google Tag Manager (optional)
VITE_GTM_ID=

# Base deployment path (empty = root domain)
VITE_BASENAME=
