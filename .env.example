# ==============================================================================
# InterDash - Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord OAuth2 Authentication Configuration
# ------------------------------------------------------------------------------
# Create an application in the Discord Developer Portal:
# https://discord.com/developers/applications
#
# Under "OAuth2" > "General", add your OAuth2 Redirect URL.
# Under "OAuth2" > "URL Generator", select scopes: 'identify' and 'email'.

# The Client ID of your Discord Application (Discord Developer Portal > General Information)
VITE_DISCORD_CLIENT_ID=

# The Client Secret of your Discord Application (Discord Developer Portal > OAuth2)
# Keep this secret; used for token exchange on server/edge endpoints
DISCORD_CLIENT_SECRET=

# OAuth2 Redirect URI (Must strictly match the Redirects in Discord Developer Portal)
# Development default: http://localhost:5173/auth/callback
# Production example:  https://interdash.enl/auth/callback
VITE_DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback

# OAuth2 Scopes requested from user during authorization
# 'identify' allows retrieving username, avatar, and Discord ID
# 'email' allows retrieving user's verified Discord email address
VITE_DISCORD_SCOPES=identify email

# ------------------------------------------------------------------------------
# 2. Administrator & Privileged Access Configuration
# ------------------------------------------------------------------------------
# Discord Snowflake User ID of the primary platform administrator.
# Used by InterDash to grant superuser / root privileges, manage global VPS nodes,
# bypass instance limits, and access live server metrics.
#
# How to get your Discord User ID:
# 1. Open Discord Settings > Advanced > Toggle "Developer Mode" ON.
# 2. Right-click your username in any channel or direct message.
# 3. Click "Copy User ID".
DISCORD_ADMIN_USER_ID=

# Optional: Discord Community / Guild ID (for Discord member verification or gated VPS access)
DISCORD_GUILD_ID=

# Optional: Discord Bot Token (for automatic role provisioning and server sync)
DISCORD_BOT_TOKEN=

# ------------------------------------------------------------------------------
# 3. Application & Deployment Settings
# ------------------------------------------------------------------------------
# Google Tag Manager ID (optional, leave empty in development)
VITE_GTM_ID=

# Base path for deployment (leave empty for root domain deployment)
VITE_BASENAME=
