# ==============================================================================
# InterDash - Production Environment Configuration (.env.example)
# Real VPS Control Plane for InterENL
# ==============================================================================
# Copy this file to .env and configure for your environment.
# NEVER commit .env to version control — it contains sensitive secrets.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------

# Node environment: 'development' | 'production'
NODE_ENV=development

# Port the Express control plane server listens on
PORT=5173

# Canonical public URL of the application
# Development: http://localhost:5173
# Production:  https://dash.interenl.com
APP_URL=http://localhost:5173

# Session secret — used to sign HTTP-only session cookies and derive encryption keys.
# MUST be a cryptographically secure random string in production (at least 64 hex characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Master AES-256-GCM encryption key for infrastructure credentials stored at rest.
# If left blank, InterDash deterministically derives the key from SESSION_SECRET.
# Must be a 32-byte hex string (64 characters) if explicitly provided.
ENCRYPTION_KEY=

# SQLite database file path (persisted transactional storage)
DATABASE_PATH=./data/interdash.db

# ------------------------------------------------------------------------------
# 2. Discord OAuth2 Configuration (SERVER-ONLY SECRETS)
# ------------------------------------------------------------------------------
# Create an application at: https://discord.com/developers/applications
#
# Add redirect URL in Discord Developer Portal > OAuth2 > Redirects:
#   Development: http://localhost:5173/api/auth/discord/callback
#   Production:  https://dash.interenl.com/api/auth/discord/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
DISCORD_SCOPES=identify email

# ------------------------------------------------------------------------------
# 3. Bootstrap Administrator Identity (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Discord Snowflake User ID of the primary platform administrator.
# On first OAuth login, this account automatically receives role = "admin".
# All other users default to role = "user".
# Get your ID: Discord Settings > Advanced > Toggle "Developer Mode" ON > Right-click profile > "Copy User ID"
DISCORD_ADMIN_USER_ID=

# ------------------------------------------------------------------------------
# 4. Proxmox VE Infrastructure Defaults (Optional Overrides)
# ------------------------------------------------------------------------------
# Default storage pool name on Proxmox nodes (e.g. local-lvm, local-zfs, ceph)
PROXMOX_DEFAULT_STORAGE=local-lvm

# Default Linux network bridge (e.g. vmbr0)
PROXMOX_DEFAULT_BRIDGE=vmbr0

# Default container OS template name/path on Proxmox storage
PROXMOX_DEFAULT_TEMPLATE=local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst

# ------------------------------------------------------------------------------
# 5. Client-Side Variables (VITE_* — Bundled into frontend, NO SECRETS HERE)
# ------------------------------------------------------------------------------
# Google Tag Manager (optional)
VITE_GTM_ID=

# Base deployment path (leave empty for root domain deployment)
VITE_BASENAME=
